{
  "schema": 1,
  "id": "com.appenetic.quiet-view",
  "version": "0.1.0-alpha.34",
  "sdk": ">=1.0 <2",
  "title": "Quiet View (experimental)",
  "summary": "A calm full-screen app after FSD v15's Quiet Mode: the streets and buildings around you from OpenStreetMap, your street lit ahead in your ambient light color, with speedometer, Self-Driving profile, arrival time and turn hints. Swipe down to close. German or English.",
  "authors": [
    {
      "name": "Appenetic",
      "url": "https://github.com/appenetic/cs-extensions"
    }
  ],
  "capabilities": [
    "service",
    "tile",
    "web.listen",
    "bind",
    "dv.read"
  ],
  "web": [
    {
      "name": "app",
      "service": "web"
    }
  ],
  "hooks": {
    "apply": {
      "run": "hooks/apply.sh",
      "rerun": "in-place",
      "phase": "late",
      "timeout": 10
    },
    "remove": {
      "run": "hooks/remove.sh",
      "timeout": 10
    },
    "service": [
      {
        "id": "web",
        "run": "hooks/web.sh",
        "restart": "on-failure"
      }
    ]
  }
}
