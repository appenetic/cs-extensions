#!/bin/bash
export PATH=/usr/tesla/UI/bin:/usr/bin:/bin:/usr/sbin:/sbin
export LD_LIBRARY_PATH=/usr/tesla/UI/lib:/usr/lib:/usr/lib64:/lib:/lib64
export HOME=/tmp/welcome-home
mkdir -p "$HOME" /tmp /run /dev/shm /tmp/dvaccess
mount -t tmpfs tmpfs /dev/shm
# All files and policies below belong to this isolated RAM-only test guest.
touch /tmp/console-sink
mount --bind /tmp/console-sink /dev/console
cat > /tmp/welcome-dbus.conf <<'BUS_END'
<busconfig>
  <type>system</type>
  <listen>unix:path=/tmp/welcome-dbus.sock</listen>
  <policy context="default">
    <allow user="*"/>
    <allow own="*"/>
    <allow send_destination="*"/>
    <allow receive_sender="*"/>
  </policy>
</busconfig>
BUS_END
export DBUS_SYSTEM_BUS_ADDRESS=unix:path=/tmp/welcome-dbus.sock
export DBUS_SESSION_BUS_ADDRESS=$DBUS_SYSTEM_BUS_ADDRESS
dbus-daemon --config-file=/tmp/welcome-dbus.conf --fork
QtCarServer >/tmp/native-carserver.log 2>&1 &
carserver=$!
for n in $(seq 1 30); do
    dbus-send --system --print-reply --dest=org.freedesktop.DBus / org.freedesktop.DBus.ListNames > /tmp/names
    grep -q 'string "com.tesla.Debug"' /tmp/names && break
    sleep 1
done
echo WELCOME_FIRMWARE_BUS_NAMES_BEGIN
cat /tmp/names
echo WELCOME_FIRMWARE_BUS_NAMES_END
for name in NAV_vehicleLatitude NAV_vehicleLongitude NAV_vehicleSpeedMph VAPI_vehicleSpeed VAPI_driverDoor VAPI_driverDoorAlert VAPI_doorState DOOR_frontDriverDoor AppeneticNonexistentProbeValue; do
    echo "TELEMETRY_READ_BEGIN $name"
    dbus-send --system --print-reply --reply-timeout=3000 --dest=com.tesla.Debug /Debug com.tesla.Debug.get_data_value string:"$name" 2>&1
    echo "TELEMETRY_READ_END $name"
done
# Synthetic values in this isolated RAM-only guest verify scalar serialization.
for pair in NAV_vehicleLatitude:52.512345 NAV_vehicleLongitude:13.412345 NAV_vehicleSpeedMph:10 VAPI_driverDoor:true VAPI_driverDoor:false; do
    name=${pair%%:*}; value=${pair#*:}
    echo "TELEMETRY_SYNTHETIC_BEGIN $name $value"
    dbus-send --system --print-reply --reply-timeout=3000 --dest=com.tesla.Debug /Debug com.tesla.Debug.set_data_value string:"$name" string:"$value" string: string:
    dbus-send --system --print-reply --reply-timeout=3000 --dest=com.tesla.Debug /Debug com.tesla.Debug.get_data_value string:"$name"
    echo "TELEMETRY_SYNTHETIC_END $name $value"
    dbus-send --system --print-reply --reply-timeout=3000 --dest=com.tesla.Debug /Debug com.tesla.Debug.set_data_value string:"$name" 'string:<invalid>' string: string: >/dev/null
done
echo TELEMETRY_LOG_BEGIN
tail -15 /tmp/native-carserver.log
echo TELEMETRY_LOG_END
kill -KILL "$carserver" 2>/dev/null || :
echo TELEMETRY_VALUES_DONE
sync
echo o > /proc/sysrq-trigger
while :; do sleep 1; done
